# Copiar a apps/api/.env
# cp .env.example apps/api/.env

# --- PostgreSQL local (ajusta usuario/clave/puerto) ---
DATABASE_URL="postgresql://TU_USUARIO:TU_PASSWORD@localhost:5432/lexcapital?schema=public"

# --- API NestJS ---
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:4200
NODE_ENV=development

# JWT (fases siguientes)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=8h

# Redis (opcional por ahora)
REDIS_URL=redis://localhost:6379

# Storage documental (local simula S3/Supabase)
# STORAGE_ROOT=/ruta/absoluta/storage
# STORAGE_PUBLIC_BASE=http://localhost:3000/api/v1/documents/file

# Sync documental CLI (npm run sync:documents [-- --dry-run])
# SYNC_DOCS_ROOT=/ruta/absoluta/Casos y documentos
