# Copiar a apps/api/.env
# cp .env.example apps/api/.env

# --- PostgreSQL (local o Neon) ---
# Neon: añade ?sslmode=require
DATABASE_URL="postgresql://TU_USUARIO:TU_PASSWORD@localhost:5432/lexcapital?schema=public"

# --- API NestJS ---
API_PORT=3000
API_PREFIX=api/v1
# En producción: URL de Netlify (separar varias con coma)
CORS_ORIGIN=http://localhost:4200
NODE_ENV=development

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=8h

# Redis (opcional)
REDIS_URL=redis://localhost:6379

# --- Storage documental ---
# local = disco (efímero en Render). supabase = persistente (recomendado en cloud)
STORAGE_DRIVER=local
# STORAGE_ROOT=/ruta/absoluta/storage
# STORAGE_PUBLIC_BASE=http://localhost:3000/api/v1/documents/file

# Supabase Storage (cuando STORAGE_DRIVER=supabase)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_STORAGE_BUCKET=lexcapital-docs

# Sync documental CLI
# SYNC_DOCS_ROOT=/ruta/absoluta/Casos y documentos

# --- Netlify (solo build frontend) ---
# NG_APP_API_BASE_URL=https://lexcapital-api.onrender.com/api/v1
